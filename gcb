#!/usr/bin/env bash
#
# GCB — Greg's Cosmic Bootstrap
#
# Run once on a machine that already has COSMIC running (Arch, CachyOS,
# Pop!_OS, or the Fedora COSMIC Spin) and GLB already installed. Idempotent
# and re-runnable, same expectation as GLB itself.
#
#   Step 1  terminal/shell        glb restore default   (delegated to GLB)
#   Step 2  theme/icon packages   native per-distro install (see below)
#   Step 3  COSMIC config         glb restore --from-manifest ./profile
#   Step 4  wallpaper             gcb writes this one directly (see §4)
#   Step 5  theme/icon selection  gsettings
#
# See docs/design/gcb-glb-boundary.md and docs/design/ricing-layer.md.
#
# Step 2 does NOT go through GLB's packages.txt/extras.txt: the theme/icon
# package names diverge more than GLB's own per-distro override tables
# cover (those tables are curated for GLB's own toolset, not open to
# extension from an external manifest), so gcb runs the right native
# command per distro directly instead of fighting that mechanism. GLB's
# manifest engine is still used for Step 3, where the reusable part
# (symlink+backup dotfiles) has no such name-resolution problem.

set -euo pipefail

GCB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# --- knobs (override via environment) --------------------------------------
GTK_THEME="${GTK_THEME:-adw-gtk3-dark}"
ICON_THEME="${ICON_THEME:-Yaru-blue-dark}"
WALLPAPER_SRC="${WALLPAPER_SRC:-$GCB_ROOT/assets/wallpaper.jpg}"
WALLPAPER_DEST_DIR="${WALLPAPER_DEST_DIR:-$HOME/.local/share/gcb}"
ADW_GTK3_REPO="${ADW_GTK3_REPO:-lassekongo83/adw-gtk3}"
# Best-effort, unverified — see docs/design/ricing-layer.md §2.
FEDORA_YARU_COPR="${FEDORA_YARU_COPR:-david35mm/yaru-theme}"

# --- output ------------------------------------------------------------------
log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# --- distro detection ---------------------------------------------------------
gcb_pkg_mgr() {
    if command -v pacman  >/dev/null 2>&1; then printf 'pacman\n';
    elif command -v dnf   >/dev/null 2>&1; then printf 'dnf\n';
    elif command -v apt-get >/dev/null 2>&1; then printf 'apt\n';
    else die "no supported package manager found (pacman/dnf/apt)"; fi
}

gcb_aur_helper() {
    if command -v yay  >/dev/null 2>&1; then printf 'yay\n';
    elif command -v paru >/dev/null 2>&1; then printf 'paru\n';
    else printf ''; fi
}

# --- preconditions -------------------------------------------------------------
[[ $EUID -ne 0 ]] || die "run as your normal user, not root"
[[ -t 0 || -t 1 ]] || warn "no TTY detected — a sudo prompt may block silently"
if ! { [[ "${XDG_CURRENT_DESKTOP:-}" == *COSMIC* ]] || pgrep -x cosmic-comp >/dev/null 2>&1; }; then
    warn "COSMIC not detected running — continuing anyway (set XDG_CURRENT_DESKTOP or run this under COSMIC)"
fi
command -v glb >/dev/null 2>&1 || die "'glb' not on PATH — install GLB first: https://github.com/ggregoro/GLB"

PKG_MGR="$(gcb_pkg_mgr)"

# --- step 1: terminal/shell, delegated to GLB -----------------------------------
step_terminal_shell() {
    log "Step 1/5 — terminal/shell (glb restore default)"
    glb restore default || warn "glb restore default reported errors — continuing"
}

# --- step 2: theme/icon packages, native per distro -----------------------------
step_theme_packages() {
    log "Step 2/5 — theme/icon packages ($PKG_MGR)"
    case "$PKG_MGR" in
        pacman)
            log "  adw-gtk-theme (official extra repo)"
            sudo pacman -S --needed --noconfirm adw-gtk-theme \
                || warn "adw-gtk-theme install failed — continuing"

            local helper
            helper="$(gcb_aur_helper)"
            if [[ -z "$helper" ]]; then
                warn "no AUR helper found (yay/paru) — skipping yaru-icon-theme. Install one and run: <helper> -S yaru-icon-theme"
            else
                log "  yaru-icon-theme (AUR via $helper)"
                "$helper" -S --needed --noconfirm yaru-icon-theme \
                    || warn "yaru-icon-theme install failed — continuing"
            fi
            ;;

        dnf)
            log "  adw-gtk3-theme (unverified as of 2026-09-12 — see ricing-layer.md)"
            sudo dnf install -y adw-gtk3-theme \
                || warn "adw-gtk3-theme install failed — verify the package name/availability on this Fedora release"

            log "  Yaru icons via COPR $FEDORA_YARU_COPR (weakest link of the 4 targets — see ricing-layer.md)"
            sudo dnf copr enable -y "$FEDORA_YARU_COPR" \
                || warn "could not enable COPR $FEDORA_YARU_COPR — install Yaru icons manually"
            sudo dnf install -y yaru-icon-theme yaru-theme \
                || warn "Yaru icon package install failed — package name inside this COPR needs confirming"
            ;;

        apt)
            log "  yaru-theme-icon (official apt package)"
            sudo apt-get install -y yaru-theme-icon \
                || warn "yaru-theme-icon install failed — continuing"

            log "  adw-gtk3-dark (no apt package exists — fetching latest release from $ADW_GTK3_REPO)"
            step_adw_gtk3_from_release || warn "adw-gtk3-dark install from GitHub release failed — continuing"
            ;;
    esac
}

# Pop!_OS/apt has no adw-gtk3 apt package anywhere (confirmed 2026-09-12,
# see ricing-layer.md); the project only ships GitHub release tarballs.
# Resolve the latest release's real asset dynamically rather than
# hardcoding a version-pinned filename that will go stale.
#
# Runs in a subshell (parens, not braces): it sets a RETURN trap for its own
# temp-dir cleanup, and a RETURN trap set inside a plain `{ }` function body
# leaks into every later function return in the parent shell, not just this
# one's — a real bash gotcha, confirmed by a sandbox run where it fired on
# an unrelated later function and died on the by-then-unbound $tmp. A
# subshell keeps the trap scoped to this call only.
step_adw_gtk3_from_release() (
    api_url="https://api.github.com/repos/$ADW_GTK3_REPO/releases/latest"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN

    asset_url="$(curl -fsSL "$api_url" \
        | grep -o '"browser_download_url": *"[^"]*\.tar\.\(xz\|gz\)"' \
        | head -n1 \
        | sed -E 's/.*"(https[^"]+)"/\1/' || true)"

    if [[ -z "$asset_url" ]]; then
        warn "could not resolve a release tarball from $api_url — install adw-gtk3-dark manually: https://github.com/$ADW_GTK3_REPO"
        return 1
    fi

    archive="$tmp/$(basename "$asset_url")"
    log "  downloading $asset_url"
    if ! curl -fsSL -o "$archive" "$asset_url"; then
        warn "download failed: $asset_url"
        return 1
    fi

    themes_dir="$HOME/.local/share/themes"
    mkdir -p "$themes_dir"
    if ! tar -xf "$archive" -C "$themes_dir"; then
        warn "failed to extract $archive into $themes_dir"
        return 1
    fi
    log "  extracted into $themes_dir"
)

# --- step 3: COSMIC config, via GLB's manifest engine ---------------------------
step_cosmic_config() {
    log "Step 3/5 — COSMIC config (glb restore --from-manifest)"
    glb restore --from-manifest "$GCB_ROOT/profile" || warn "glb restore --from-manifest reported errors — continuing"
}

# --- step 4: wallpaper -----------------------------------------------------------
#
# Not a plain dotfile: the RON file's source: field is a hardcoded absolute
# path, and GLB's dotfile symlinking has no templating (see
# docs/design/ricing-layer.md §4). gcb places the asset at a fixed,
# gcb-controlled path and writes this one file itself.
step_wallpaper() {
    log "Step 4/5 — wallpaper"
    [[ -f "$WALLPAPER_SRC" ]] || { warn "wallpaper asset not found: $WALLPAPER_SRC"; return 1; }

    mkdir -p "$WALLPAPER_DEST_DIR"
    cp "$WALLPAPER_SRC" "$WALLPAPER_DEST_DIR/wallpaper.jpg"

    local dest="$HOME/.config/cosmic/com.system76.CosmicBackground/v1/all"
    mkdir -p "$(dirname "$dest")"
    if [[ -f "$dest" ]] && ! cmp -s "$dest" <(gcb_wallpaper_ron); then
        cp "$dest" "$dest.gcb-backup.$(date +%s)"
        log "  backed up existing wallpaper config"
    fi
    gcb_wallpaper_ron > "$dest"
    log "  wrote $dest"
}

gcb_wallpaper_ron() {
    cat <<EOF
(
    output: "all",
    source: Path("$WALLPAPER_DEST_DIR/wallpaper.jpg"),
    filter_by_theme: true,
    rotation_frequency: 300,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
EOF
}

# --- step 5: GTK theme/icon selection ---------------------------------------------
step_theme_selection() {
    log "Step 5/5 — GTK theme/icon selection (gsettings)"
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" \
        || warn "could not set gtk-theme to $GTK_THEME"
    gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" \
        || warn "could not set icon-theme to $ICON_THEME"
}

main() {
    step_terminal_shell
    step_theme_packages
    step_cosmic_config
    step_wallpaper || warn "wallpaper step failed — continuing"
    step_theme_selection

    log "GCB complete."
    cat <<EOF

Verify:
  - Legacy GTK3 apps pick up $GTK_THEME / $ICON_THEME
    (COSMIC's own native panel/dock/apps don't use GTK theming at all —
    that's expected, not a bug)
  - Wallpaper shows immediately (COSMIC's settings daemon watches config
    files live, no reload needed)
  - Dock is full-width along the bottom edge, top panel absent
  - A second run of this script is a no-op (no unexpected
    *.gcb-backup.* files)
EOF
}

main "$@"
